# Copie para .env (desenvolvimento) e .env.test (testes). Nunca commite .env.
NODE_ENV=development
PORT=3333
LOG_LEVEL=info

# mysql://usuario:senha@host:porta/banco
DATABASE_URL=mysql://cemita:cemita_dev@127.0.0.1:3306/cemita_dev
DB_POOL_MAX=10
# true em produção quando o MySQL gerenciado exigir TLS
DB_SSL=false

# Segredo do token de acompanhamento do pedido (mínimo 32 caracteres aleatórios).
# Gere um com: node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
# Em produção: um valor próprio, guardado só nas variáveis do servidor.
TRACKING_TOKEN_SECRET=dev-somente-local-troque-em-producao-0000000

# Atrás de proxy reverso (Vercel/Render/Nginx...): número de proxies confiáveis
TRUST_PROXY=0
# Origens que podem chamar a API (separadas por vírgula)
CORS_ORIGINS=http://localhost:5173

# Painel da equipe
# Horas que a sessão vale depois do login (1 a 72)
SESSION_TTL_HOURS=12
# Tentativas de login por IP a cada 15 minutos
LOGIN_RATE_LIMIT=10
# Custo do scrypt das senhas (2^N). Deixe sem definir para o padrão (17). Em produção, nunca abaixo de 17.
# AUTH_SCRYPT_LOG_N=17

# ── Pagamento online (Etapa 6) — Mercado Pago, Checkout Pro ─────────────────────────
# none (padrão) = só pagamento na entrega/retirada. Passo a passo: PAGAMENTO-MERCADOPAGO.md (raiz do projeto)
PAYMENT_PROVIDER=none
# Credenciais da aplicação no painel do Mercado Pago (Suas integrações > Credenciais). Use as de TESTE até validar.
# Nunca coloque o Access Token no site (.env.local) nem no git.
MP_ACCESS_TOKEN=
# "Assinatura secreta" gerada em Suas integrações > Webhooks (confere que o aviso veio do Mercado Pago)
MP_WEBHOOK_SECRET=
# true só se a página de pagamento de teste não abrir com o link normal
MP_SANDBOX=false
# Endereço do site para onde o Mercado Pago devolve o cliente (acompanhamento do pedido)
PUBLIC_SITE_URL=http://localhost:5173

# ── Eventos da Agenda: leitura automática do post (opcional) ──────────────────────
# Chave da API da Anthropic (console.anthropic.com). Sem ela, o painel cadastra eventos à mão (sem o botão de IA).
ANTHROPIC_API_KEY=
# Modelo (opcional). Vazio = padrão do projeto (rápido, barato e lê imagem).
AI_MODEL=

# ── Publicação (produção) — passo a passo: PUBLICAR.md (raiz do projeto) ──────────
# Pasta do site compilado. No Docker já vem definida (/app/dist): o mesmo serviço entrega site, painel e API.
# SITE_DIR=
# Primeira publicação: cria a conta de administração se o painel ainda não tiver nenhuma.
# Depois do primeiro login, APAGUE estas três do servidor.
# BOOTSTRAP_ADMIN_NAME=
# BOOTSTRAP_ADMIN_EMAIL=
# BOOTSTRAP_ADMIN_PASSWORD=
# Política de privacidade que o cliente aceita ao pedir. Sem ela, o site não aceita pedidos.
# Mudou o texto? Troque a versão (ex.: 2027-01) e publique: a nova passa a valer e a antiga fica no histórico.
# PRIVACY_POLICY_VERSION=2026-11
# PRIVACY_POLICY_URL=https://cemita.com.br/politica-de-privacidade.html
