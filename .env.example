# Endereço da API de pedidos (pasta server/).
# Vazio ou ausente: o site funciona como antes, só com o cardápio de src/config.
# Para desenvolvimento local, com a API rodando (npm run dev dentro de server):
VITE_API_URL=http://localhost:3333/api/v1

# Endereço público do site (para a prévia do link no WhatsApp/Instagram, o Google e o sitemap).
# Ex.: https://cemita.com.br — só preencha quando o site estiver publicado nesse endereço.
# Vazio: a imagem de compartilhamento fica com caminho relativo e não há canonical/sitemap.
VITE_SITE_URL=
